---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getContent, chapters, href, postHref, seriesHref, tagHref, dateLabel, readingTime } from '../../lib/content';
export async function getStaticPaths() {
  const { posts } = await getContent();
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
const { posts, series } = await getContent();
const currentSeries = series.find((item) => item.data.slug === post.data.series);
const list = currentSeries ? chapters(posts, currentSeries.data.slug) : [];
const position = list.findIndex((item) => item.data.slug === post.data.slug);
const previous = list[position - 1];
const next = list[position + 1];
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<Base title={post.data.title} description={post.data.description} article noindex={post.data.draft}>
  <div class="breadcrumb" data-pagefind-ignore><a href={href('posts/')}>全部文章</a><span>/</span>{currentSeries ? <a href={seriesHref(currentSeries)}>{currentSeries.data.title}</a> : <span>独立手记</span>}</div>
  {post.data.draft && <div class="draft-notice" data-pagefind-ignore>本地草稿预览 · 此文章不会进入生产网站、搜索或 RSS。公开仓库中的原稿仍然可见。</div>}
  <div class="article-layout">
    <article class="article" data-pagefind-body>
      <header class="article-header"><div class="eyebrow">{currentSeries ? `${currentSeries.data.title} / 第 ${position + 1} 篇` : 'FIELD NOTE'}</div><h1 data-pagefind-meta="title">{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="post-meta"><time datetime={post.data.publishedAt.toISOString()}>{dateLabel(post.data.publishedAt)}</time><span>·</span><span>{readingTime(post.body)} 分钟阅读</span>{post.data.updatedAt && <span>修订于 {dateLabel(post.data.updatedAt)}</span>}</div><div class="tag-row" data-pagefind-ignore>{post.data.tags.map((tag) => <a href={tagHref(tag)}># {tag}</a>)}</div></header>
      <div class="prose"><Content /></div>
      <div class="article-end" data-pagefind-ignore><span>— 本篇完 —</span><a href={href('subscribe/')}>通过 RSS 订阅后续更新 ↗</a></div>
      {(previous || next) && <nav class="chapter-navigation" aria-label="系列上下篇" data-pagefind-ignore>{previous ? <a href={postHref(previous)}><small>← 上一篇</small><strong>{previous.data.title}</strong></a> : <div />}{next ? <a href={postHref(next)}><small>下一篇 →</small><strong>{next.data.title}</strong></a> : <div />}</nav>}
    </article>
    <aside class="article-sidebar" data-pagefind-ignore>
      {toc.length > 0 && <details class="toc" open><summary>本篇目录</summary><nav aria-label="本篇目录">{toc.map((heading) => <a class:list={{ subheading: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details>}
      {currentSeries && <div class="sidebar-series"><span class="eyebrow">系列阅读</span><a class="sidebar-series-title" href={seriesHref(currentSeries)}>{currentSeries.data.title} ↗</a><ol>{list.map((item) => <li><a class:list={{ current: item.data.slug === post.data.slug }} aria-current={item.data.slug === post.data.slug ? 'page' : undefined} href={postHref(item)}>{item.data.title}</a></li>)}</ol></div>}
    </aside>
  </div>
</Base>
