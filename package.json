{
  "name": "fieldnotes-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run validate",
    "dev": "astro dev --host 127.0.0.1",
    "dev:stop": "astro dev stop",
    "validate": "node scripts/validate-content.mjs",
    "check": "astro check",
    "build": "npm run validate && astro check && astro build && pagefind --site dist && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "preview:stop": "astro preview stop",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "new:post": "node scripts/new-content.mjs post",
    "new:series": "node scripts/new-content.mjs series",
    "export:post": "node scripts/export-post.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "8.3.4",
    "yaml": "2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
